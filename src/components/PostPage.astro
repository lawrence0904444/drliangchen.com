---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORY_LABELS, localize, type Lang } from '../i18n';
import { formatDate, getPosts, postSlug } from '../lib';

interface Props { post: CollectionEntry<'blog'>; lang: Lang }
const { post, lang } = Astro.props;
const { Content } = await render(post);
// 有另一語言的同名文章就互連，沒有就讓切換鈕回到另一語言的文章列表
const other = lang === 'zh' ? 'en' : 'zh';
const translated = (await getPosts(other)).some((p) => postSlug(p) === postSlug(post));
---
<Base title={post.data.title} description={post.data.description} alt={translated ? localize(`/blog/${postSlug(post)}/`, other) : false}>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      <a class="chip" href={localize(`/category/${post.data.category}/`, lang)}>{CATEGORY_LABELS[lang][post.data.category]}</a>
      {post.data.tags.map((t) => <span class="chip">#{t}</span>)}
    </div>
    <Content />
  </article>
</Base>
