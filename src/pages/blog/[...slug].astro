---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../content.config';
import { getPosts, formatDate } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <a class="chip" href={`/category/${post.data.category}/`}>{CATEGORIES[post.data.category]}</a>
      {post.data.tags.map((t) => <span class="chip">#{t}</span>)}
    </div>
    <Content />
  </article>
</Base>
