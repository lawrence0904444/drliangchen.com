---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib';

const posts = (await getPosts('en')).slice(0, 5);
---
<Base>
  <h1>Hi, I'm Liang Chen</h1>
  <p class="lead">
    A PGY physician in Taiwan. This is where I keep <a href="/en/category/notes/">notes</a> from clinical training,
    <a href="/en/category/tools/">tools</a> I build with code and AI, and the occasional <a href="/en/category/essays/">essay</a>.
  </p>
  <h2>Latest posts</h2>
  <PostList posts={posts} lang="en" />
  <p><a href="/en/blog/">All posts →</a></p>
</Base>
