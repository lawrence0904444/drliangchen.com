---
import Base from '../layouts/Base.astro';

// 只要改這裡的資料，頁面會自動排版。沒有內容的區塊（空陣列）不會顯示。
const cv = [
  {
    heading: '學歷',
    items: [
      { when: '20XX–20XX', what: 'OO 大學 醫學系', note: '醫學士（M.D.）' },
    ],
  },
  {
    heading: '臨床訓練',
    items: [
      { when: '20XX–', what: 'OO 醫院 一般醫學訓練（PGY）', note: '' },
    ],
  },
  {
    heading: '研究與發表',
    items: [
      // { when: '2026', what: 'Chen L, et al. 論文標題. 期刊名. 2026;卷(期):頁.', note: '' },
    ],
  },
  {
    heading: '學術海報與演講',
    items: [
      // { when: '2026', what: '海報標題', note: 'OO 學會年會' },
    ],
  },
  {
    heading: '證照',
    items: [
      { when: '20XX', what: '中華民國醫師證書', note: '' },
      // { when: '20XX', what: 'ACLS / PALS', note: '' },
    ],
  },
  {
    heading: '專案與工具',
    items: [
      // { when: '2026', what: '專案名稱', note: '一句話說明，可加 GitHub 連結' },
    ],
  },
  {
    heading: '獲獎',
    items: [],
  },
];
---
<Base title="簡歷" description="陳亮醫師的學經歷、研究發表與專案。">
  <h1>簡歷</h1>
  <p class="lead">陳亮 Liang Chen, MD</p>

  {cv.filter((s) => s.items.length > 0).map((section) => (
    <section class="cv-section">
      <h2>{section.heading}</h2>
      {section.items.map((item) => (
        <div class="cv-item">
          <span class="when">{item.when}</span>
          <div>
            {item.what}
            {item.note && <div class="meta">{item.note}</div>}
          </div>
        </div>
      ))}
    </section>
  ))}
</Base>
